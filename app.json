{
  "expo": {
    "name": "Family Cup",
    "slug": "clark-cup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clarkcup",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.clarkcup.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Family Cup uses your photo library to attach photos to point submissions and update your profile picture.",
        "NSCameraUsageDescription": "Family Cup uses your camera to take photos for submissions.",
        "NSUserNotificationsUsageDescription": "Family Cup sends weekly reminders to help you earn points.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1B4332"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Clark Cup uses your photo library to attach photos to submissions and update your profile picture."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38ca123f-ae30-4d6d-b2be-cc7ef30fc404"
      }
    },
    "owner": "karilynaclark"
  }
}
